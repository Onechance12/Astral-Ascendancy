// Astral Ascendancy — Prisma schema
// Beta-2: accounts, commander, match history, decks, collection, currency,
// quests, campaigns, operations, season pass.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  commander     Commander?
  headquarters  Headquarters?
  matches       MatchRecord[]
  decks         Deck[]
  cards         UserCard[]
  cardInstances CardInstance[]
  structureInstances StructureInstance[]
  quests        UserQuest[]
  campaignProg  CampaignProgress[]
  opProg        OperationProgress[]
  planets       Planet[]
  developments  DevelopmentProgress[]
  pvpRanks      PvpRank[]
  pvpQueue      PvpQueueEntry[]
  pvpMatchesAsA PvpMatch[] @relation("PvpMatchPlayerA")
  pvpMatchesAsB PvpMatch[] @relation("PvpMatchPlayerB")
  sentInvites   PvpMatchInvite[] @relation("InviteSender")
  receivedInvites PvpMatchInvite[] @relation("InviteRecipient")
  friendRequestsSent Friend[] @relation("FriendRequester")
  friendRequestsReceived Friend[] @relation("FriendAddressee")
  foundedTribes Tribe[] @relation("TribeFounder")
  tribeMemberships TribeMember[]
  assignments   Assignment[]
  deckLicenses  DeckLicense[]
  loginStreak   LoginStreak?
  rewards       RewardInbox[]
}

// A player's in-game identity (chosen at signup)
model Commander {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Zharvox"
  title       String   // e.g. "Herald of Dawn"
  factionId   String   // solari | voidborn | crystalline | reavers | quantum

  wins        Int      @default(0)
  losses      Int      @default(0)
  matches     Int      @default(0)
  influence   Int      @default(0) // total Cosmic Influence earned (Ascension attempts)

  // progression economy
  shards      Int      @default(0)  // Aether Shards (crafting currency)
  seasonXp    Int      @default(0)  // current-season XP
  seasonTier  Int      @default(0)  // current-season tier
  collectionLevel Int  @default(0)  // rises with unique cards acquired
  pityCounter Int      @default(0)  // wins since last Rare+ drop (hard pity at 10)
  premiumPass Boolean  @default(false)

  // infrastructure resources
  plasma      Int      @default(0)  // ☀ energy from stars (Solari)
  biomass     Int      @default(0)  // ☣ organic matter (Voidborn)
  crystals    Int      @default(0)  // ◆ minerals (Crystalline)
  tritium     Int      @default(0)  // ⚔ fuel from gas giants (Reavers + travel)
  quantumCores Int     @default(0)  // ⬡ AI/compute (Quantum)
  lastHarvest DateTime @default(now()) // last time passive resources were collected

  activeDeckId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Headquarters / Homeworld ----------
// The player's capital base. Commander is the identity; Headquarters is the place.
model Headquarters {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  homeworldName String
  homeworldType String // star | organic | mineral | gas | anomaly | barren
  doctrine    String   @default("balanced") // balanced | expansion | research | war | recovery

  capitalLevel Int     @default(1)
  commandLevel Int     @default(1)
  infirmaryLevel Int   @default(0)
  trainingLevel Int    @default(0)
  researchLevel Int    @default(0)
  engineeringLevel Int @default(0)
  hangarLevel Int      @default(0)
  securityLevel Int    @default(1)

  morale      Int      @default(50)
  stability   Int      @default(50)
  alertLevel  String   @default("calm") // calm | strained | threatened | crisis
  activeProjectKey String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, homeworldType])
  @@index([userId, doctrine])
}

model MatchRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commanderName String
  factionId   String
  enemyName   String
  enemyFactionId String
  result      String   // "win" | "loss"
  turns       Int
  playerHpLeft Int
  enemyHpLeft  Int
  mode        String   @default("conquest") // conquest | ascension | multiplayer | campaign
  difficulty  String   @default("normal")   // easy | normal | hard
  playedAt    DateTime @default(now())

  // rewards granted for this match (for display)
  dropCardDefId String?
  shardsEarned  Int     @default(0)
  seasonXpEarned Int    @default(0)
}

model Deck {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  factionId   String
  cardDefIds  String   // JSON array of defId strings
  isActive    Boolean  @default(false)
  format      String   @default("standard") // standard | event | campaign | open_war
  powerScore  Int      @default(0)
  powerTier   String   @default("starter") // starter | skirmish | veteran | ascendant | mythic | open_war
  powerVersion String  @default("pvp-v1")
  pvpLocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, powerTier])
}

// ---------- Beta Live-Game Loop ----------
model Assignment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // resource | study | rescue | training | defense | expedition | project
  title       String
  status      String   @default("active") // active | ready | claimed | canceled
  assetType   String   // crew | card | deck | world | project
  cardDefId   String?
  cardInstanceId String?
  deckId      String?
  planetId    String?
  description String?
  rewardsJson String   @default("{}")
  startedAt   DateTime @default(now())
  completesAt DateTime
  claimedAt   DateTime?
  canceledAt  DateTime?

  @@index([userId, status, completesAt])
  @@index([userId, deckId, status])
  @@index([userId, cardDefId, status])
  @@index([userId, cardInstanceId, status])
  @@index([userId, planetId, status])
}

model DeckLicense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseId   String   // starter | skirmish | veteran | ascendant | mythic | open_war
  deckTier    String
  unlocked    Boolean  @default(false)
  progress    Int      @default(0)
  target      Int      @default(1)
  unlockedAt  DateTime?
  rewardClaimed Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, licenseId])
  @@index([userId, deckTier])
}

// ---------- Daily Retention & Reward Inbox ----------
model LoginStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastClaimedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RewardInbox {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType  String   // daily_login | assignment | quest | operation | pack | campaign | system
  sourceId    String?
  title       String
  description String?
  rewardJson  String   @default("{}")
  revealType  String   @default("standard") // standard | daily | pack | rare | mythic | singularity
  status      String   @default("ready") // ready | claimed | expired
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  claimedAt   DateTime?

  @@unique([userId, sourceType, sourceId])
  @@index([userId, status, createdAt])
  @@index([userId, sourceType, sourceId])
}

// ---------- PvP ----------
model PvpRank {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season      String   @default("alpha")
  queueType   String   @default("ranked") // ranked | event
  tier        String   // starter | skirmish | veteran | ascendant | mythic | open_war
  rankName    String   @default("Bronze Orbit")
  division    Int      @default(5)
  rating      Int      @default(1000)
  peakRating  Int      @default(1000)
  wins        Int      @default(0)
  losses      Int      @default(0)
  streak      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, season, queueType, tier])
  @@index([tier, rating])
}

model PvpQueueEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId      String
  queueType   String   // ranked | unranked | event
  tier        String
  powerScore  Int
  rating      Int      @default(1000)
  status      String   @default("queued") // queued | matched | canceled | expired
  matchId     String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  matchedAt   DateTime?

  @@index([queueType, tier, status, rating])
  @@index([userId, status])
}

model PvpMatch {
  id          String   @id @default(cuid())
  season      String   @default("alpha")
  queueType   String   // ranked | unranked | friendly | event
  tier        String
  status      String   @default("created") // created | active | reported | finalized | void
  playerAId   String
  playerA     User     @relation("PvpMatchPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerBId   String
  playerB     User     @relation("PvpMatchPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)
  playerADeckId String
  playerBDeckId String
  playerAPower Int
  playerBPower Int
  playerARatingBefore Int @default(1000)
  playerBRatingBefore Int @default(1000)
  playerARatingAfter  Int?
  playerBRatingAfter  Int?
  winnerUserId String?
  resultReason String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  endedAt     DateTime?

  @@index([queueType, tier, status])
  @@index([playerAId, createdAt])
  @@index([playerBId, createdAt])
}

model PvpMatchInvite {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  deckId      String?
  ruleSet     String   @default("tier_cap") // open_power | tier_cap | starter | draft | experimental
  tierCap     String?
  status      String   @default("pending") // pending | accepted | declined | canceled | expired
  message     String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  respondedAt DateTime?

  @@index([recipientId, status])
  @@index([senderId, status])
}

// ---------- Friends And Tribes ----------
model Friend {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted | declined | blocked
  createdAt   DateTime @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Tribe {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  emblemGlyph String   @default("✦")
  factionBanner String?
  privacy     String   @default("invite") // open | invite | closed
  founderId   String
  founder     User     @relation("TribeFounder", fields: [founderId], references: [id], onDelete: Cascade)
  memberLimit Int      @default(50)
  xp          Int      @default(0)
  influence   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TribeMember[]
  missions    TribeMission[]

  @@index([founderId])
}

model TribeMember {
  id          String   @id @default(cuid())
  tribeId     String
  tribe       Tribe    @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member") // founder | officer | member
  contribution Int     @default(0)
  joinedAt    DateTime @default(now())

  @@unique([tribeId, userId])
  @@index([userId])
}

model TribeMission {
  id          String   @id @default(cuid())
  tribeId     String
  tribe       Tribe    @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  season      String   @default("alpha")
  type        String   // ranked_wins | influence | event_boss | resource_drive
  title       String
  target      Int
  progress    Int      @default(0)
  reward      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  endsAt      DateTime?

  @@index([tribeId, active])
}

// ---------- Collection ----------
// One row per unique card def the user owns. `count` = copies.
model UserCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defId       String   // references CARD_DEFS defId
  count       Int      @default(1)
  xp          Int      @default(0)
  level       Int      @default(1)
  matchesPlayed Int    @default(0)
  source      String   @default("drop") // drop | craft | quest | campaign | operation | starter
  acquiredAt  DateTime @default(now())
  lastPlayedAt DateTime?

  @@unique([userId, defId])
  @@index([userId])
}

// One row per real owned card copy. This is the living-asset layer:
// location, condition, assignment, deck/world/ship placement, XP, and history.
// `UserCard` remains the collection-count summary for pack/crafting UI.
model CardInstance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defId       String
  source      String   @default("drop")

  displayName String?
  title       String?
  xp          Int      @default(0)
  level       Int      @default(1)

  // location: collection | deck | assignment | headquarters | world | structure | ship | recovery | training | medical | repair | captured | missing
  location    String   @default("collection")
  // status: available | busy | unavailable
  status      String   @default("available")
  // condition: healthy | fatigued | injured | critical | fallen | damaged | restoring
  condition   String   @default("healthy")

  currentAssignmentId String?
  deckId      String?
  planetId    String?
  structureKey String?
  shipId      String?
  equippedToInstanceId String?
  metadataJson String   @default("{}")

  acquiredAt  DateTime @default(now())
  lastStateChangeAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, defId])
  @@index([userId, status, location])
  @@index([userId, condition])
  @@index([userId, currentAssignmentId])
  @@index([userId, deckId])
  @@index([userId, planetId])
}

// ---------- Quests ----------
model Quest {
  id          String   @id @default(cuid())
  kind        String   // "daily" | "weekly" | "story"
  type        String   // quest trigger type: win | deploy | cast | faction_win | capture | campaign
  target      Int      // numeric goal
  title       String
  description String
  rewardShards Int     @default(0)
  rewardCardDefId String? // optional card reward
  rewardPackRarity String? // optional pack rarity
  factionId   String?  // optional faction filter
  createdAt   DateTime @default(now())

  userQuests  UserQuest[]
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  assignedAt  DateTime @default(now())
  expiresAt   DateTime?  // null = no expiry (story quests)

  @@unique([userId, questId, assignedAt])
  @@index([userId])
}

// ---------- Campaigns (Story) ----------
model Campaign {
  id          String   @id @default(cuid())
  factionId   String
  chapter     Int      // 1..5
  title       String
  intro       String   // narrative intro shown before the match
  outro       String   // narrative outro shown after victory
  enemyName   String
  enemyFactionId String
  enemyDeckIds String  // JSON array of defIds for the enemy
  enemyHp     Int      @default(12)
  rewardCardDefIds String // JSON array of defIds granted on completion
  rewardShards Int     @default(0)
  rewardQuestId String? // optional quest to auto-complete
  createdAt   DateTime @default(now())

  progress    CampaignProgress[]

  @@unique([factionId, chapter])
}

model CampaignProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  completedAt DateTime?

  @@unique([userId, campaignId])
  @@index([userId])
}

// ---------- Operations (limited-time events: Rescue / Bounty) ----------
model Operation {
  id          String   @id @default(cuid())
  type        String   // "rescue" | "bounty"
  name        String
  lore        String
  target      Int      // numeric goal (e.g. wins needed)
  factionId   String?
  rewardCardDefIds String // JSON array — the "captured/rescued" cards
  rewardShards Int     @default(0)
  rewardCommanderTitle String? // flavor title granted
  startsAt    DateTime @default(now())
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  progress    OperationProgress[]
}

model OperationProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@unique([userId, operationId])
  @@index([userId])
}

// ---------- Infrastructure: Planets & Structures ----------
// A player owns planets in their sector. Each planet can host one structure.
model Planet {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Vrellis Prime"
  planetType  String   // star | organic | mineral | gas | anomaly | barren
  sector      String   @default("home") // home | conquered sector name
  slot        Int      // position in sector (0-5)
  structureType String? // solar_harvester | biomass_farm | crystal_mine | gas_refinery | quantum_array | null
  structureLevel Int   @default(0) // 0 = no structure, 1-5 = built levels
  lastCollect DateTime @default(now())
  claimedAt   DateTime @default(now())
  sourceCardDefId String? // which planet card was used to claim this (null = starter)

  // crew assignment (one crew card per planet)
  crewCardDefId String? // defId of the assigned crew card
  crewCardInstanceId String?
  crewAssignedAt DateTime?

  structureInstances StructureInstance[]

  @@index([userId])
  @@index([userId, crewCardInstanceId])
}

// A built domain structure as a real container. Planet.structureType/level remains
// the resource-production summary; StructureInstance is where living cards can be stationed.
model StructureInstance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planetId    String
  planet      Planet   @relation(fields: [planetId], references: [id], onDelete: Cascade)

  type        String   // solar_harvester | biomass_farm | crystal_mine | gas_refinery | quantum_array
  name        String
  level       Int      @default(1)
  slot        Int      @default(0)
  status      String   @default("active") // active | damaged | disabled | destroyed | repairing
  integrity   Int      @default(100)
  maxIntegrity Int     @default(100)
  capacity    Int      @default(1)

  sourceCardDefId String?
  sourceCardInstanceId String?
  metadataJson String   @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([planetId, type])
  @@index([userId, status])
  @@index([userId, planetId])
}

// ---------- Developments (tech tree, activated from cards) ----------
model DevelopmentProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devCardDefId String  // the development card defId
  activatedAt DateTime @default(now())

  @@unique([userId, devCardDefId])
  @@index([userId])
}

// Structure definitions (static, not per-user) — stored as a config table
// so we can query costs/rates without hardcoding
model StructureDef {
  id          String   @id @default(cuid())
  type        String   @unique // solar_harvester | biomass_farm | crystal_mine | gas_refinery | quantum_array
  name        String
  glyph       String
  resourceType String  // plasma | biomass | crystals | tritium | quantumCores
  description String
  baseRate    Int      // resource per hour at level 1
  baseCostShards Int   // cost to build (level 0 → 1)
  baseCostResource Int // cost in same resource type to build
  createdAt   DateTime @default(now())
}
